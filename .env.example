# Evolution API config (copy to .env and fill in real values)
AUTHENTICATION_API_KEY=sales_funnel_evo_key_2026
CONFIG_SESSION_PHONE_VERSION=2.3000.1015901307
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution:***@postgres:5432/evolution_db
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
# Redis for Evolution API (v2.3.2 uses CACHE_REDIS_* prefix)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379/0
CACHE_REDIS_TTL=604800
CACHE_REDIS_PREFIX_KEY=evolution

# --- Flask app settings ---
OPENROUTER_API_KEY=your_openrouter_key_here
WA_WEBHOOK_SECRET=
WA_WEBHOOK_URL=http://flask-app:5050/api/wa/webhook
EVO_INSTANCE=sales_funnel
ADMIN_PASSWORD=change_me_to_strong_password
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# --- Evolution API server ---
SERVER_PORT=8080
SERVER_URL=http://localhost:8080
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=true
WEBHOOK_GLOBAL_ENABLED=false

# --- Watchtower auto-deploy (GHCR credentials) ---
# Create a GitHub Personal Access Token with read:packages scope
# at https://github.com/settings/tokens
GITHUB_ACTOR=alley1818
GITHUB_TOKEN=ghp_your_token_here

# --- Config.json backup ---
# config_data/ is mounted as volume and persists across rebuilds.
# Back up config_data/config.json manually or via cron to avoid losing UI settings.
# Settings are edited via UI -> Settings tab, stored in config_data/config.json.
